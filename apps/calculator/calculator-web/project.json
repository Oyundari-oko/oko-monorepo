{
  "name": "calculator-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/calculator/calculator-web",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/calculator/calculator-web"
      },
      "configurations": {
        "development": {
          "outputPath": "apps/calculator/calculator-web"
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "calculator-web:build",
        "dev": true
      },
      "configurations": {
        "development": {
          "buildTarget": "calculator-web:build:development",
          "dev": true
        },
        "production": {
          "buildTarget": "calculator-web:build:production",
          "dev": false
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx jest --config=apps/calculator/calculator-web/jest.config.ts --coverage"
      }
    }
  }
}
