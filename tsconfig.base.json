{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "target": "es2024",
    "module": "esnext",
    "skipLibCheck": true,
    "paths": {
      "@oko-monorepo/shadcn": ["./libs/shared/shadcn/src/index.ts"],
      "@oko-monorepo/shadcn/utils": ["./libs/shared/shadcn/src/lib/utils.ts"],
      "@oko-monorepo/shadcn/ui": ["./libs/shared/shadcn/src/ui"],
      "@oko-monorepo/shadcn/lib": ["./libs/shared/shadcn/src/lib"],
      "@oko-monorepo/shadcn/hooks": ["./libs/shared/shadcn/src/hooks"],
      "@oko-monorepo/todo-service": ["./apps/todo/todo-service/src/index.ts"],
      "@oko-monorepo/school-funding-service": [
        "./apps/school-funding/school-funding-service/src/index.ts"
      ],
      "@oko-monorepo/clerk": ["./libs/shared/clerk/src/auth.ts"],
      "@oko-monorepo/goal-tracker-service": [
        "./apps/goal-tracker/goal-tracker-service/src/index.ts"
      ],
      "@oko-monorepo/sat-ai-coach": ["./sat-ai/sat-ai-coach/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
